<include>
<extension name="caretech-gloria" >
    <condition field="destination_number" expression="^443338805247$-disabled">
        <action application="set" data="continue_on_fail=true"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <!-- <action application="bridge" data="user/martin"/> -->
        <action application="answer"/>
        <action application="set" data="RECORD_TITLE=Recording ${destination_number} ${caller_id_number} ${strftime(%Y-%m-%d %H:%M)}"/>
        <action application="set" data="RECORD_STEREO=true"/>
        <action application="record_session" data="/tmp/gloria-${strftime(%Y-%m-%d-%H-%M-%S)}.wav"/>
        <action application="sleep" data="1000"/>
        <action application="send_dtmf" data="db@80"/>
        <action application="play_and_get_digits" data="24 24 2 5000 A '' ''"/>
        <action application="sleep" data="150"/>
        <action application="send_dtmf" data="db@80"/>
        <action application="sleep" data="150"/>
        <action application="send_dtmf" data="4w1@80"/>
        <action application="playback" data="local_stream://moh"/>
    </condition>
</extension>
<extension name="essence-es7502hc-ap-k06" >
    <condition field="destination_number" expression="^443338805247$-disabled">
        <action application="set" data="continue_on_fail=true"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <!-- <action application="bridge" data="user/martin"/> -->
        <action application="answer"/>
        <action application="set" data="RECORD_TITLE=Recording ${destination_number} ${caller_id_number} ${strftime(%Y-%m-%d %H:%M)}"/>
        <action application="set" data="RECORD_STEREO=true"/>
        <action application="record_session" data="/tmp/essence-${strftime(%Y-%m-%d-%H-%M-%S)}.wav"/>
        <action application="sleep" data="5000"/>
        <action application="send_dtmf" data="0@150"/><!-- must follow with delay greater than tone duration -->
        <action application="sleep" data="200"/>
        <action application="playback" data="local_stream://moh"/>
    </condition>
</extension>
<extension name="scaber" >
    <condition field="destination_number" expression="^443338805247$">
        <action application="set" data="drop_dtmf=true"/>
        <action application="set" data="park_after_bridge=true"/>
        <action application="park"/>
        <!--<action application="answer"/>-->
        <!--<action application="sleep" data="32000"/>-->
    </condition>
</extension>
</include>
