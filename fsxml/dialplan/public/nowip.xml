<extension name="nowip" >
    <condition field="destination_number" expression="^nowip$|^nowip-[\w-]+$"/>
    <condition field="caller_id_number" expression="anonymous|unavailable" break="on-true">
        <action application="hangup" data="REQUESTED_CHAN_UNAVAIL"/>
    </condition>
    <condition>
        <action application="set" data="send_silence_when_idle=1000"/>
        <action application="set" data="eavesdrop_group=scaber"/>
        <action application="set" data="RECORD_STEREO=true"/>
        <action application="set" data="record_file_path=$${recordings_dir}/${strftime(%Y-%m-%dT%H-%M-%SZ)}.${caller_id_number}.wav"/>
        <action application="record_session" data="${record_file_path}"/>
        <action application="park"/>
    </condition>
</extension>
