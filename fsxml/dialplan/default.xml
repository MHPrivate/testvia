<context name="default" >
    <extension name="unloop">
        <condition field="${unroll_loops}" expression="^true$"/>
        <condition field="${sip_looped_call}" expression="^true$">
            <action application="deflect" data="${destination_number}"/>
        </condition>
    </extension>

    <extension name="internationalize">
        <condition field="destination_number" expression="^00(\d*)$" break="never">
            <action application="transfer" data="+$1"/>
        </condition>
        <condition field="destination_number" expression="^0(\d*)$" break="never">
            <action application="transfer" data="+44$1"/>
        </condition>
        <condition field="destination_number" expression="^(44\d{8,}\d*)$" break="never"><!-- depreciated-->
            <action application="transfer" data="+$1"/>
        </condition>
    </extension>

    <extension name="global" continue="true">
        <condition field="${call_debug}" expression="^true$" break="never">
            <action application="info"/>
        </condition>

        <condition field="${default_password}" expression="^1234$" break="never">
            <action application="log" data="CRIT WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING "/>
            <action application="log" data="CRIT Open $${conf_dir}/vars.xml and change the default_password."/>
            <action application="log" data="CRIT Once changed type 'reloadxml' at the console."/>
            <action application="log" data="CRIT WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING "/>
            <action application="sleep" data="10000"/>
        </condition>
        <!--
            This is an example of how to auto detect if telephone-event is missing and activate inband detection
        -->
        <!--
        <condition field="${switch_r_sdp}" expression="a=rtpmap:(\d+)\stelephone-event/8000" break="never">
            <action application="set" data="rtp_payload_number=$1"/>
            <anti-action application="start_dtmf"/>
        </condition>
        -->
        <condition field="${rtp_has_crypto}" expression="^($${rtp_sdes_suites})$" break="never">
            <action application="set" data="rtp_secure_media=true"/>
            <!-- Offer SRTP on outbound legs if we have it on inbound. -->
            <!-- <action application="export" data="rtp_secure_media=true"/> -->
        </condition>

        <!--
            Since we have inbound-late-negotation on by default now the
            above behavior isn't the same so you have to do one extra step.
        -->
        <condition field="${endpoint_disposition}" expression="^(DELAYED NEGOTIATION)"/>
        <condition field="${switch_r_sdp}" expression="(AES_CM_128_HMAC_SHA1_32|AES_CM_128_HMAC_SHA1_80)" break="never">
            <action application="set" data="rtp_secure_media=true"/>
            <!-- Offer SRTP on outbound legs if we have it on inbound. -->
            <!-- <action application="export" data="rtp_secure_media=true"/> -->
        </condition>

        <condition>
            <action application="hash" data="insert/${domain_name}-spymap/${caller_id_number}/${uuid}"/>
            <action application="hash" data="insert/${domain_name}-last_dial/${caller_id_number}/${destination_number}"/>
            <action application="hash" data="insert/${domain_name}-last_dial/global/${uuid}"/>
            <action application="export" data="RFC2822_DATE=${strftime(%a, %d %b %Y %T %z)}"/>
        </condition>
    </extension>

    <extension name="reject">
        <!-- database sipFilters driven extension to reject the call -->
        <condition field="${eval({%= !!hangup %})}" expression="^true$">
            <action application="hangup" data="{%= hangup %}"/>
        </condition>
    </extension>

    <extension name="scaber-eavesdrop">
        <condition field="destination_number" expression="^722237$">
            <action application="set" data="eavesdrop_require_group=scaber"/>
            <action application="answer"/>
            <action application="eavesdrop" data="all"/>
        </condition>
    </extension>

    <extension name="park">
        <condition field="${appello_dev}" expression="^true$"/>
        <condition field="destination_number" expression="^(park|7275)$">
            <!-- fs_send_unsupported_info enables sending INFOs where 'send_info' is not listed in the X-FS-Support header -->
            <action application="set" data="fs_send_unsupported_info=true"/>
            <!-- fs_send_unsupported_message enables sending MESSAGEs where 'send_message' is not listed in the X-FS-Support header -->
            <action application="set" data="fs_send_unsupported_message=true"/>
            <action application="info"/>
            <action application="answer"/>
            <!--<action application="sched_hangup" data="+5"/>-->
            <action application="park"/>
        </condition>
    </extension>

    <extension name="grouped-callback" continue="false">
        <condition field="destination_number" expression="^(\+|00)\d+\D\d{4}$">
            <action application="park"/>
        </condition>
        <!--
        <condition field="${sip_h_x-inin-cnv}" expression="^$" break="never">
            <action application="hangup" data="REQUESTED_CHAN_UNAVAIL"/>
        </condition>
        -->
    </extension>

    <extension name="sip-terminal-adapter">
        <condition field="destination_number" expression="^440000">
            <action application="park"/>
        </condition>
        <condition field="caller_id_number" expression="martin" break="on-true">
            <anti-action application="hangup" data="REQUESTED_CHAN_UNAVAIL"/>
        </condition>
    </extension>

    <extension name="nowip" >
        <condition field="destination_number" expression="^nowip$|^nowip-[\w-]+$|^nowip2$|^nowip2-[\w-]+$">
            <!-- fs_send_unsupported_info enables sending INFOs where 'send_info' is not listed in the X-FS-Support header -->
            <action application="set" data="fs_send_unsupported_info=true"/>
            <!-- fs_send_unsupported_message enables sending MESSAGEs where 'send_message' is not listed in the X-FS-Support header -->
            <action application="set" data="fs_send_unsupported_message=true"/>
            <action application="set" data="send_silence_when_idle=1000"/>
            <action application="set" data="eavesdrop_group=scaber"/>
            <action application="set" data="RECORD_STEREO=true"/>
            <action application="set" data="record_file_path=$${recordings_dir}/${strftime(%Y-%m-%dT%H-%M-%SZ)}.${caller_id_number}.wav"/>
            <!-- <action application="record_session" data="${record_file_path}"/> -->
            <action application="park"/>
        </condition>
    </extension>

    <extension name="scaip" >
        <condition field="destination_number" expression="^scaip$|^scaip-[\w-]+$">
            <!-- fs_send_unsupported_info enables sending INFOs where 'send_info' is not listed in the X-FS-Support header -->
            <action application="set" data="fs_send_unsupported_info=true"/>
            <!-- fs_send_unsupported_message enables sending MESSAGEs where 'send_message' is not listed in the X-FS-Support header -->
            <action application="set" data="fs_send_unsupported_message=true"/>
            <action application="set" data="send_silence_when_idle=1000"/>
            <action application="set" data="eavesdrop_group=scaber"/>
            <action application="set" data="RECORD_STEREO=true"/>
            <action application="set" data="record_file_path=$${recordings_dir}/${strftime(%Y-%m-%dT%H-%M-%SZ)}.${caller_id_number}.wav"/>
            <!-- <action application="record_session" data="${record_file_path}"/> -->
            <action application="park"/>
            <!--<action application="answer"/>-->
            <!--<action application="sleep" data="32000"/>-->
        </condition>
    </extension>

    <!-- file: {%= __filename %}, basedir: {%= path.resolve(path.dirname(__filename), 'default') %}, sub: {%= query['Caller-Destination-Number'] %} -->
{%-
    (function (base, dir, sub) {
        var basedir = `${base}/${dir}`, fpath = `${basedir}/${sub}.xml`, stat = fs.existsSync(fpath) && fs.statSync(fpath);
        if (!sub) { // include all .xml from folder
            return fs.statSync(basedir).isDirectory()
                ? fs.readdirSync(basedir)
                    .filter(sub=>sub.endsWith('.xml') && fs.statSync(`${basedir}/${sub}`).isFile())
                    .map(sub=>include(`${dir}/${sub}`))
                    .join('')
                : undefined;
        } else if (stat && stat.isFile() && stat.size) { // substantive file
            return include(`${dir}/${sub}.xml`);
        }
    })(path.dirname(__filename), 'default', query['Caller-Destination-Number']) // __dirname, 'default', '1000'
-%}

    <extension name="scheme" continue="true">
        <!-- ensure the target is an SLS destination -->
        <condition field="destination_number" expression="^4\d{8}$" break="on-false"/>
        <!-- database lookup indicates next-hop is registered on this this cone-server -->
        <condition field="${sofia_contact(*/{%= dialPrefix %})}" expression="sofia" break="never">
            <action application="set" data="hangup_after_bridge=true"/>
            <action application="set" data="continue_on_fail=true"/>
            <action application="set" data="bridge=${sofia_contact(*/{%= dialPrefix %})}" inline="true"/>
            <!-- Offer SRTP on outbound legs if the contact contains 'transport=tls'. -->
            <!-- lua-regex:'gw%+[^@]+' equivalent to posix-regex:/gw\+[^@]+/ -->
            <action application="bridge" data="{rtp_secure_media=${regex(${bridge}|(?i)transport=tls)}}${lua(~stream:write(tostring(string.gsub('${bridge}','gw%+[^@]+','${destination_number}'))))}"/>
        </condition>
        <!-- database lookup indicates next-hop is registered on another cone-server -->
        <condition field="${cond(${hostname} == {%= cone %} ? true : false)}" expression="^false$" break="never">
            <!-- skip these if _cone_ is this host -->
            <action application="set" data="hangup_after_bridge=true"/>
            <action application="set" data="continue_on_fail=true"/>
            <action application="set" data="sip_h_X-AppelloExpedite={%= appelloExpedite %}"/>
            <action application="bridge" data="{rtp_secure_media=true}sofia/ext4tls/${destination_number}@{%= cone %}:5061;transport=tls"/>
        </condition>
    </extension>

    <extension name="martin">
        <condition field="destination_number" expression="^(\+|00|0)\d+$"/>
        <condition field="username" expression="^martin">
            <action application="multiset" data="hangup_after_bridge=true continue_on_fail=false"/>
            <action application="bridge" data="{origination_caller_id_number=+447802827727}sofia/gateway/magrathea/${destination_number}"/>
        </condition>
    </extension>

    <extension name="catchall">
        <condition>
            <action application="set" data="RECORD_STEREO=true"/>
            <action application="record_session" data="/tmp/${strftime(%Y-%m-%d-%H-%M-%S)}.${caller_id_number}.wav"/>
            <action application="bridge" data="group/default"/>
        </condition>
    </extension>
</context>
