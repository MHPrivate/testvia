<context name="public">
    <extension name="unloop">
        <condition field="${unroll_loops}" expression="^true$"/>
        <condition field="${sip_looped_call}" expression="^true$">
            <action application="deflect" data="${destination_number}"/>
        </condition>
    </extension>

    <extension name="outside_call" continue="true">
        <condition>
            <action application="set" data="outside_call=true"/>
            <action application="export" data="RFC2822_DATE=${strftime(%a, %d %b %Y %T %z)}"/>
        </condition>
    </extension>

    <extension name="global" continue="true">
        <condition field="${call_debug}" expression="^true$" break="never">
            <action application="info"/>
        </condition>

        <condition>
            <action application="hash" data="insert/${domain_name}-spymap/${caller_id_number}/${uuid}"/>
            <action application="hash" data="insert/${domain_name}-last_dial/${caller_id_number}/${destination_number}"/>
            <action application="hash" data="insert/${domain_name}-last_dial/global/${uuid}"/>
            <action application="export" data="RFC2822_DATE=${strftime(%a, %d %b %Y %T %z)}"/>
        </condition>
    </extension>

    <!-- file: {%= __filename %}, basedir: {%= path.resolve(path.dirname(__filename), 'public') %}, sub: {%= query['Caller-Destination-Number'] %} -->
{% if (expedite) { -%}
    <extension name="expedite">
        <condition field="${eval({%= !!expedite %})}" expression="^true$">
            <action application="set" data="bypass_media={%= expedite.byps || false %}"/>
            <action application="set" data="effective_caller_id_number={%= expedite.numb %}"/>
            <action application="set" data="effective_caller_id_name='{%= expedite.name %}'"/>
            <action application="set" data="hangup_after_bridge=true"/>
            <action application="set" data="continue_on_fail=true"/>
            <action application="set" data="bridge=${sofia_contact(user/{%= expedite.prfx %})}" inline="true"/>
            <!-- Offer SRTP on outbound legs if the contact contains 'transport=tls'. -->
            <action application="bridge" data="{rtp_secure_media=${regex(${bridge}|transport=tls)}}${lua(~stream:write(tostring(string.gsub('${bridge}','gw%+[^@]+','{%= expedite.dest %}'))))}"/>
            <!-- lua-regex:'gw%+[^@]+' same-as posix-regex:/gw\+[^@]+/ -->
        </condition>
    </extension>
{%  } else { -%}
{%- (function (base, dir, sub) {
        var basedir = `${base}/${dir}`, fpath = `${basedir}/${sub}.xml`, stat = fs.existsSync(fpath) && fs.statSync(fpath).isFile();
        if (!sub) { // include all .xml from folder
            return fs.statSync(basedir).isDirectory()
                ? fs.readdirSync(basedir)
                    .filter(sub=>fs.statSync(`${basedir}/${sub}`).isFile())
                    .map(sub=>include(`${dir}/${sub}`))
                    .join('')
                : undefined
        } else if (stat && stat.isFile() && stat.size) { // substantive file
            return include(`${dir}/${sub}.xml`)
        }
    })(path.dirname(__filename), 'public', query['Caller-Destination-Number']) // __dirname, 'public', '1000'
-%}
{%  } -%}

    <extension name="public-trusted">
        <condition field="${acl(${network_addr} public.trusted)}" expression="^true$">
            <action application="set" data="domain_name=$${domain}"/>
            <action application="transfer" data="${destination_number} XML default"/>
        </condition>
    </extension>

    <extension name="catchall">
        <condition>
            <action application="bridge" data="group/default"/>
        </condition>
    </extension>
</context>
