    <include>
        <param name="INCLUDING" value="{%= `${path.basename(__filename)}` %}"/>
        <!-- Dialplan context in which to dump calls that come in to this profile's ip:port -->
        <param name="context" value="public"/>
        <param name="debug" value="0"/>
        <param name="dialplan" value="XML"/>
        <param name="dtmf-duration" value="2000"/>
        <!-- RFC 5626 : Send reg-id and sip.instance -->
        <!--<param name="enable-rfc-5626" value="true"/>-->
        <!--All inbound reg will stored in the db using this domain-->
        <param name="force-register-db-domain" value="$${domain}"/>
        <!--All inbound reg will look in this domain for the users-->
        <param name="force-register-domain" value="$${domain}"/>
        <!--Force the domain in subscriptions to this value-->
        <param name="force-subscription-domain" value="$${domain}"/>
        <!-- <param name="forward-unsolicited-mwi-notify" value="false"/> -->
        <param name="hold-music" value="$${hold_music}"/>
        <param name="inbound-codec-negotiation" value="generous"/>
        <!-- This parameter allows to change the allowed inbound codecs per profile -->
        <param name="inbound-codec-prefs" value="$${global_codec_prefs}"/>
        <!-- let calls hit the dialplan *before* you decide if the codec is OK -->
        <param name="inbound-late-negotiation" value="true"/>
        <param name="inbound-zrtp-passthru" value="true"/>
        <!--This defines your local network, by default we detect your local network and create this localnet.auto ACL for this-->
        <param name="local-network-acl" value="localnet.auto"/>
        <!--<param name="log-auth-failures" value="true"/>-->
        <param name="media_hold_timeout" value="1800"/>
        <param name="media_timeout" value="300"/>
        <!-- TTL for nonce in sip auth -->
        <param name="nonce-ttl" value="60"/>
        <!-- This parameter allows to change the outbound codecs per profile -->
        <param name="outbound-codec-prefs" value="$${global_codec_prefs}"/>
        <param name="presence-hosts" value="$${domain}"/>
        <param name="presence-privacy" value="$${presence_privacy}"/>
        <param name="record-path" value="$${recordings_dir}"/>
        <param name="record-template" value="${strftime(%Y-%m-%dT%H-%M-%SZ)}.${caller_id_number}.wav"/>
        <param name="rfc2833-pt" value="101"/>
        <param name="rtp-digit-delay" value="8"/><!-- 80ms -->
        <param name="rtp-timer-name" value="soft"/>
        <!--<param name="shutdown-on-fail" value="true"/>-->
        <param name="sip-capture" value="no"/>
        <param name="sip-trace" value="no"/>
        <!-- additional bind parameters for TLS -->
        <param name="tls-bind-params" value="transport=tls"/>
        <!-- Location of the agent.pem cafile.pem ssl and wss.pem certificates (needed for TLS server) -->
        <param name="tls-cert-dir" value="$${certs_dir}"/>
        <!-- TLS ciphers default: ALL:!ADH:!LOW:!EXP:!MD5:@STRENGTH  -->
        <param name="tls-ciphers" value="$${sip_tls_ciphers}"/>
        <!-- Optionally set the passphrase password used by openSSL to encrypt/decrypt TLS private key files -->
        <param name="tls-passphrase" value=""/>
        <!-- Verify the date on TLS certificates -->
        <param name="tls-verify-date" value="false"/>
        <!-- Certificate max verify depth to use for validating peer TLS certificates when the verify policy is not none -->
        <param name="tls-verify-depth" value="2"/>
        <!-- If the tls-verify-policy is set to subjects_all or subjects_in this sets which subjects are allowed, multiple subjects can be split with a '|' pipe -->
        <param name="tls-verify-in-subjects" value=""/>
        <!-- TLS verify policy, when registering/inviting gateways with other servers (outbound) or handling inbound registration/invite requests how should we verify their certificate -->
        <!-- set to 'in' to only verify incoming connections, 'out' to only verify outgoing connections, 'all' to verify all connections, also 'subjects_in', 'subjects_out' and 'subjects_all' for subject validation. Multiple policies can be split with a '|' pipe -->
        <param name="tls-verify-policy" value="none"/>
        <!-- TLS version ("sslv23" (default), "tlsv1"). NOTE: Phones may not work with TLSv1 -->
        <param name="tls-version" value="$${sip_tls_version}"/>
        <param name="use-rtp-timer" value="true"/>
    </include>
