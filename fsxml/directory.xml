<section  name="directory" description="User Directory">
    <domain name="$${domain}">
        <params>
            <!-- endpoints:
                sofia/_profile_/_user_@_domain_ 
                sofia/gateway/_gatewayname_/_user_
                user/_userid_ 
                group/_groupname_
                loopback/_dest_ 
                freetdm/_span_/_chan_/_number_ 
            -->

            <!-- dial-strings:
                ^^:                                                     colon-seperator
                <variable_scope=super-global>
                    {variable_scope=thread1}
                        [variable_scope=leg1a]<target_endpoint>[,       comma-simultaneous
                        [variable_scope=leg1b]<target_endpoint>][|      pipe-sequential
                        <target_endpoint>]:_:                           enterprise-simultaneous
                    {variable_scope=thread2}
                        [variable_scope=leg2a]<target_endpoint>[,       comma-simultaneous
                        [variable_scope=leg2b]<target_endpoint>][|      pipe-sequential
                        <target_endpoint>]
            -->
            <param name="dial-string" value="{sip_invite_domain=${dialed_domain},presence_id=${dialed_user}@${dialed_domain},rtp_secure_media=${regex(${sofia_contact(${dialed_user}@${dialed_domain})}|transport=tls)}}${sofia_contact(*/${dialed_user}@${dialed_domain})},${verto_contact(${dialed_user}@${dialed_domain})}"/>
            <!-- These are required for Verto to function properly -->
            <param name="jsonrpc-allowed-methods" value="verto"/>
            <!-- <param name="jsonrpc-allowed-event-channels" value="demo,conference,presence"/> -->
            <param name="password" value="$${default_password}"/>
        </params>
        <variables>
            <variable name="record_stereo" value="true"/>
            <variable name="default_gateway" value="$${default_provider}"/>
            <variable name="default_areacode" value="$${default_areacode}"/>
            <variable name="transfer_fallback_extension" value="operator"/>
        </variables>
